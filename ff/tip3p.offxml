<SMIRNOFF version="0.3" aromaticity_model="OEAroModel_MDL">
  <vdW version="0.3" potential="Lennard-Jones-12-6" combining_rules="Lorentz-Berthelot" scale12="0.0" scale13="0.0" scale14="0.5" scale15="1.0" cutoff="9.0 * angstrom" switch_width="1.0 * angstrom" method="cutoff">
    <Atom smirks="[#1:1]-[#8X2H2+0:2]-[#1]" epsilon="0.0 * kilocalorie_per_mole" rmin_half="0.0 * angstrom"/>
    <Atom smirks="[#1]-[#8X2H2+0:1]-[#1]" epsilon="0.1520 * kilocalorie_per_mole" rmin_half="1.7682 * angstrom"/>
  </vdW>
  <Electrostatics version="0.3" scale14="0.8333333333" cutoff="9.0 * angstrom" method="PME"/>
  <LibraryCharges version="0.3">
    <LibraryCharge smirks="[#1:1]-[#8X2H2+0:2]-[#1:3]" charge1="0.417 * elementary_charge" charge2="-0.834 * elementary_charge" charge3="0.417 * elementary_charge"/>
  </LibraryCharges>
  <Bonds version="0.3" potential="harmonic">
    <Bond smirks="[#1:1]-[#8X2H2+0:2]" length="0.9572 * angstrom" k="107.55 * kilocalorie_per_mole/angstrom**2"/>
  </Bonds>
  <Angles version="0.3" potential="harmonic">
    <Angle smirks="[#1:1]-[#8X2H2+0:2]-[#1:3]" angle="104.52 * degree" k="99.58 * kilocalorie_per_mole/radian**2"/>
  </Angles>
</SMIRNOFF>
